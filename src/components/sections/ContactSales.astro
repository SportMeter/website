---
/**
 * ContactSales.astro
 *
 * Upgraded contact form for the /contact page.
 * - Toggle: signing up for yourself vs. someone in your club
 * - Conditional fields based on toggle selection
 * - Netlify Forms (AJAX submission so we can show a thank-you state inline)
 * - Locale-aware text via Astro.currentLocale
 * - "Myself": after step 1 the onboarding questionnaire (OnboardingWizard)
 *   follows inline, so the visitor keeps going without a page change.
 * - "Someone from my club": we only take the sign-up. The person signed up
 *   fills in the questionnaire themselves through a personal /start link,
 *   which is shown to the submitter and included in the form submission.
 */
import { getRelativeLocaleUrl } from "astro:i18n";
import { ONBOARDING_PATH } from "@/lib/onboarding";
import OnboardingFormDefinition from "./OnboardingFormDefinition.astro";
import OnboardingWizard from "./OnboardingWizard.astro";

const lang = Astro.currentLocale ?? "nl";
const isEN = lang === "en";

// Path of the stand-alone questionnaire in the visitor's language; the browser
// prefixes its own origin so the link is right on every deployment.
const onboardingPath = getRelativeLocaleUrl(lang, ONBOARDING_PATH);

const t = {
  heading: isEN ? "Ready to join?" : "Klaar om mee te doen?",
  subheading: isEN
    ? "Leave your details and we'll explore how SportMeter can work for your club."
    : "Laat je gegevens achter, dan kijken we samen hoe we SportMeter bij jullie kunnen inzetten.",

  toggleLabel: isEN ? "I am signing up for..." : "Ik schrijf in voor...",
  optionSelf: isEN ? "Myself" : "Mezelf",
  optionOther: isEN ? "Someone from my club" : "Iemand uit mijn vereniging",

  nameLabel: isEN ? "Full name" : "Volledige naam",
  namePlaceholder: isEN ? "John Smith" : "Jan de Vries",

  clubLabel: isEN ? "Club" : "Vereniging",
  clubPlaceholder: isEN ? "Name of your club" : "Naam van je vereniging",

  myEmailLabel: isEN ? "My email address" : "Mijn e-mailadres",
  myEmailPlaceholder: isEN ? "my@email.com" : "mijn@email.com",

  consentSelf: isEN
    ? "I agree that SportMeter may contact me"
    : "Ik ga akkoord dat SportMeter contact met mij opneemt",

  consentOther: isEN
    ? "I have the permission of this person and have discussed this with them"
    : "Ik heb toestemming van deze persoon en heb dit met hen besproken",

  otherEmailLabel: isEN
    ? "Email address of the person"
    : "E-mailadres van de betrokken persoon",
  otherEmailPlaceholder: isEN ? "their@email.com" : "hun@email.com",

  submitLabel: isEN ? "Submit" : "Verzenden",
  nextLabel: isEN ? "Next" : "Volgende",
  sendingLabel: isEN ? "Sending..." : "Verzenden...",

  errorMessage: isEN
    ? "Something went wrong while sending. Please try again."
    : "Er ging iets mis bij het verzenden. Probeer het opnieuw.",

  privacyNote: isEN
    ? "Your contact details will only be used to get in touch about SportMeter."
    : "Je contactgegevens gebruiken we alleen om contact op te nemen over SportMeter.",

  thankYouTitle: isEN ? "Thank you!" : "Bedankt!",
  thankYouMessage: isEN
    ? "We've received your sign-up. Share the link below with the person you signed up: with it they answer a few short questions themselves, so we can set up their account ahead of time."
    : "We hebben je aanmelding ontvangen. Deel de link hieronder met de persoon die je hebt aangemeld: daarmee beantwoordt diegene zelf een paar korte vragen, zodat we het account alvast kunnen klaarzetten.",
  shareLinkLabel: isEN ? "Personal link for" : "Persoonlijke link voor",
  copyLabel: isEN ? "Copy link" : "Link kopiëren",
  copiedLabel: isEN ? "Copied!" : "Gekopieerd!",
};
---

<div
  class="items-center gap-x-[6.25rem] pb-20 md:pb-40 auto-cols-fr justify-center flex"
  data-onboarding-path={onboardingPath}
  x-data="{
    mode: 'self',
    stage: 'form',
    sending: false,
    error: false,
    lead: { name: '', email: '', club: '' },
    otherEmail: '',
    shareLink: '',
    copied: false,
    buildShareLink(email, club) {
      const params = new URLSearchParams({ email });
      if (club) params.set('club', club);
      return window.location.origin + this.$root.dataset.onboardingPath + '?' + params.toString();
    },
    async copyShareLink() {
      try {
        await navigator.clipboard.writeText(this.shareLink);
        this.copied = true;
        setTimeout(() => { this.copied = false; }, 2000);
      } catch {
        this.$refs.shareLink?.select();
      }
    },
    async submit(form) {
      if (this.sending) return;
      this.sending = true;
      this.error = false;
      const data = new FormData(form);
      this.lead = {
        name: String(data.get('name') ?? ''),
        email: String(data.get('email') ?? ''),
        club: String(data.get('club') ?? '')
      };
      if (this.mode === 'other') {
        this.otherEmail = String(data.get('other_email') ?? '');
        this.shareLink = this.buildShareLink(this.otherEmail, this.lead.club);
        data.set('onboarding_link', this.shareLink);
      }
      try {
        const res = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(data).toString()
        });
        if (!res.ok) throw new Error('Submission failed');
        this.stage = this.mode === 'self' ? 'onboarding' : 'thanks';
        this.$nextTick(() => this.$root.scrollIntoView({ behavior: 'smooth', block: 'start' }));
      } catch {
        this.error = true;
      } finally {
        this.sending = false;
      }
    }
  }"
>
  <div class="col-span-1 row-span-1 w-full max-w-3xl">

    <!-- ─── Thank-you state ("someone from my club") ────────────────────── -->
    <div x-show="stage === 'thanks'" x-cloak class="py-24 flex flex-col items-center text-center">
      <div class="flex items-center justify-center w-16 h-16 bg-black rounded-full mb-8">
        <svg
          class="w-8 h-8 text-white"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h2 class="text-4xl md:text-[3.13rem] leading-none font-semibold my-1">{t.thankYouTitle}</h2>
      <p class="mt-6 text-lg text-gray-600 max-w-xl">{t.thankYouMessage}</p>

      <!-- Personal questionnaire link for the person who was signed up -->
      <div class="mt-10 w-full max-w-xl text-left">
        <p class="text-black font-semibold mb-3">
          {t.shareLinkLabel} <span x-text="otherEmail"></span>
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <input
            type="text"
            readonly
            x-ref="shareLink"
            :value="shareLink"
            @focus="$el.select()"
            aria-label={t.shareLinkLabel}
            class="text-zinc-800 px-4 py-4 w-full h-14 min-h-[3.50rem] border-2 border-black border-solid rounded-md m-0 bg-gray-50 text-sm sm:text-base"
          />
          <button
            type="button"
            @click="copyShareLink()"
            class="button-primary bg-black text-white items-center justify-center py-2.5 px-6 text-center inline-flex rounded-md font-semibold text-lg whitespace-nowrap"
          >
            <span x-show="!copied">{t.copyLabel}</span>
            <span x-show="copied" x-cloak>{t.copiedLabel}</span>
          </button>
        </div>
      </div>
    </div>

    <!-- ─── Onboarding questionnaire ("myself", after step 1) ───────────── -->
    <template x-if="stage === 'onboarding'">
      <div>
        <OnboardingWizard prefill="parent" />
      </div>
    </template>

    <!-- ─── Form state ──────────────────────────────────────────────────── -->
    <div x-show="stage === 'form'">

      <!-- Heading -->
      <div class="items-center text-sm font-medium justify-center flex">
        <h2 class="text-4xl md:text-[3.13rem] leading-none font-semibold my-1">{t.heading}</h2>
      </div>
      <p class="mb-1 mt-10 text-gray-700">{t.subheading}</p>

      <!-- Toggle -->
      <div class="mt-8 mb-8">
        <p class="text-black font-semibold max-w-full mb-3">{t.toggleLabel}</p>
        <div class="inline-flex border-2 border-black rounded-md overflow-hidden">
          <button
            type="button"
            @click="mode = 'self'"
            :aria-pressed="mode === 'self'"
            :class="mode === 'self'
              ? 'bg-black text-white'
              : 'bg-white text-black hover:bg-gray-50'"
            class="px-5 py-2.5 text-base font-semibold transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-500"
          >
            {t.optionSelf}
          </button>
          <button
            type="button"
            @click="mode = 'other'"
            :aria-pressed="mode === 'other'"
            :class="mode === 'other'
              ? 'bg-black text-white'
              : 'bg-white text-black hover:bg-gray-50'"
            class="px-5 py-2.5 text-base font-semibold transition-colors duration-150 border-l-2 border-black focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-500"
          >
            {t.optionOther}
          </button>
        </div>
      </div>

      <!-- Form (Netlify — AJAX submission to stay on page) -->
      <form
        name="contact-sales"
        method="POST"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
        @submit.prevent="submit($el)"
        class="mt-0 mx-0 mb-3.5 auto-cols-fr grid-cols-1 sm:grid-cols-2 grid-rows-[auto] grid gap-8"
      >
        <!-- Netlify bot honeypot -->
        <input type="hidden" name="bot-field" />
        <!-- Required for Netlify AJAX submissions -->
        <input type="hidden" name="form-name" value="contact-sales" />
        <!-- Passes the selected mode as a hidden field -->
        <input type="hidden" name="type" :value="mode" />
        <!-- "Someone from my club": personal questionnaire link for that person, filled in on submit -->
        <input type="hidden" name="onboarding_link" value="" />

        <!-- ── Shared fields ─────────────────────────────── -->

        <!-- Name -->
        <div class="text-base">
          <p class="text-black font-semibold max-w-full mb-3">{t.nameLabel}</p>
          <input
            type="text"
            name="name"
            required
            placeholder={t.namePlaceholder}
            class="text-zinc-800 cursor-text px-4 py-4 w-full h-14 min-h-[3.50rem] border-2 border-black border-solid rounded-md m-0"
          />
        </div>

        <!-- Club -->
        <div class="text-base">
          <p class="text-black font-semibold max-w-full mb-3">{t.clubLabel}</p>
          <input
            type="text"
            name="club"
            required
            placeholder={t.clubPlaceholder}
            class="text-zinc-800 cursor-text px-4 py-4 w-full h-14 min-h-[3.50rem] border-2 border-black border-solid rounded-md m-0"
          />
        </div>

        <!-- My email (always required) -->
        <div class="text-base sm:col-span-2">
          <p class="text-black font-semibold max-w-full mb-3">{t.myEmailLabel}</p>
          <input
            type="email"
            name="email"
            required
            placeholder={t.myEmailPlaceholder}
            class="text-zinc-800 cursor-text px-4 py-4 w-full h-14 min-h-[3.50rem] border-2 border-black border-solid rounded-md m-0"
          />
        </div>

        <!-- ── Self branch ────────────────────────────────── -->
        <div x-show="mode === 'self'" class="sm:col-span-2">
          <label class="flex items-start gap-3 cursor-pointer">
            <input
              type="checkbox"
              name="consent_self"
              :required="mode === 'self'"
              :disabled="mode !== 'self'"
              class="mt-1 w-5 h-5 border-2 border-black rounded cursor-pointer flex-shrink-0 accent-black"
            />
            <span class="text-base text-zinc-800">{t.consentSelf}</span>
          </label>
        </div>

        <!-- ── Other branch ───────────────────────────────── -->
        <div x-show="mode === 'other'" x-cloak class="sm:col-span-2 grid grid-cols-1 gap-8">
          <!-- Consent checkbox -->
          <div>
            <label class="flex items-start gap-3 cursor-pointer">
              <input
                type="checkbox"
                name="consent_other"
                :required="mode === 'other'"
                :disabled="mode !== 'other'"
                class="mt-1 w-5 h-5 border-2 border-black rounded cursor-pointer flex-shrink-0 accent-black"
              />
              <span class="text-base text-zinc-800">{t.consentOther}</span>
            </label>
          </div>

          <!-- Other person's email -->
          <div class="text-base">
            <p class="text-black font-semibold max-w-full mb-3">{t.otherEmailLabel}</p>
            <input
              type="email"
              name="other_email"
              :required="mode === 'other'"
              :disabled="mode !== 'other'"
              placeholder={t.otherEmailPlaceholder}
              class="text-zinc-800 cursor-text px-4 py-4 w-full h-14 min-h-[3.50rem] border-2 border-black border-solid rounded-md m-0"
            />
          </div>
        </div>

        <!-- ── Submit ─────────────────────────────────────── -->
        <div class="sm:col-span-2">
          <button
            type="submit"
            :disabled="sending"
            class="button-primary bg-black text-white items-center justify-center py-2.5 px-6 text-center inline-flex max-w-full rounded-md font-semibold text-xl disabled:opacity-60 disabled:cursor-wait"
          >
            <span x-show="!sending" x-text={`mode === 'self' ? ${JSON.stringify(t.nextLabel)} : ${JSON.stringify(t.submitLabel)}`}>{t.nextLabel}</span>
            <span x-show="sending" x-cloak>{t.sendingLabel}</span>
          </button>
          <p x-show="error" x-cloak class="mt-4 text-red-600 font-semibold" role="alert">
            {t.errorMessage}
          </p>
        </div>
      </form>

      <span class="text-sm italic">* {t.privacyNote}</span>
    </div>
  </div>
</div>

<!-- Static definition so Netlify registers the contact-onboarding form and its fields -->
<OnboardingFormDefinition />

<style>
  /* Match the existing button transition from Link.astro */
  .button-primary {
    transition: opacity 0.2s;
  }
  .button-primary:hover {
    opacity: 0.85;
  }
</style>

<style is:global>
  /* Hide Alpine x-cloak elements before Alpine initialises */
  [x-cloak] {
    display: none !important;
  }
</style>
