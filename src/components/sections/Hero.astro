---
import type { ButtonProps } from "@/components/primitives/Button.astro";
import Container from "@/components/primitives/Container.astro";
import Link from "@/components/primitives/Link.astro";
import Blob from "@/components/sections/Blob.astro";

interface Props {
	title: string;
	subtitle: string;
	buttons?: ButtonProps[];
}

const defaultButtons: ButtonProps[] = [
	{
		title: "Contact",
		href: "#contact",
		style: "button",
		icon: "iconamoon:arrow-top-right-1-thin",
	},
];

const { title, subtitle, buttons = defaultButtons } = Astro.props;
---

<div
	id="hero"
	class="items-center text-sm font-medium justify-center pb-24 md:pb-48 lg:px-20 pt-32 lg:pt-44 relative flex min-h-[100svh]"
>
	<Container>
		<div class="items-center flex-col w-full m-auto">
			<div
				class="items-center auto-cols-fr grid-cols-1 lg:grid-cols-2 grid-rows-[auto] grid gap-8 md:gap-[3.13rem]"
			>
				<div
					class="items-start flex-col justify-start flex gap-2 row-start-1"
				>
					<h1
						data-hero-reveal
						class="text-3xl md:text-6xl leading-tight my-3 mx-0"
						set:html={title}
					/>
					<div class="lg:mt-20">
						<div>
							<p
								data-hero-reveal
								class=" text-lg lg:text-2xl font-regular mb-3"
								set:html={subtitle}
							/>
							<div class="mt-10 text-white">
								{
									buttons.map(
										({ title, href, style, icon }) => (
											<Link
                        id="contact-landing-button"
												data-hero-reveal
												href="#"
												style={
													style as
														| "primary"
														| "button"
														| "outline"
														| "buttonLight"
												}
												icon={icon}
											>
												{title}
											</Link>
										),
									)
								}
							</div>
						</div>
					</div>
				</div>
				<div class="justify-self-center col-span-1 row-span-1">
					<Blob class="xl:pl-32" />
				</div>
			</div>
		</div>
		<div
			class="items-center bottom-[3.13rem] justify-center left-0 absolute right-0 z-10 flex max-w-[80%] overflow-hidden m-auto text-blue-700"
		>
			<div class="items-center flex">
				<button
					id="scroll-down-button"
					class="scroll-down-button items-start justify-center underline flex w-5 h-7 max-w-full border-2 border-black border-solid rounded-xl m-auto"
					><div class="bg-black cursor-pointer w-0.5 h-1 mt-1.5">
					</div>
				</button>
			</div>
		</div>
	</Container>
</div>

<style>
	@keyframes moveDown {
		0% {
			transform: translateY(0);
		}
		80% {
			transform: translateY(2px);
		}
		100% {
			transform: translateY(0);
		}
	}

	.scroll-down-button:hover div {
		animation: moveDown 0.7s infinite;
	}
	[data-hero-reveal] {
		opacity: 0;
		filter: blur(3px);
	}
</style>

<noscript>
	<style>
		[data-hero-reveal] {
			opacity: 1 !important;
			filter: none !important;
		}
	</style>
</noscript>

<script>
	import { gsap } from "gsap";
	import { ScrollToPlugin } from "gsap/ScrollToPlugin";
	import { BlurPlugin } from "@/utils/gsap-blur";

	gsap.registerPlugin(ScrollToPlugin, BlurPlugin);

	function scrollDown() {
		gsap.to(window, { duration: 0.5, scrollTo: "#services" });
	}
	function scrollDownContact() {
		gsap.to(window, { duration: 0.8, scrollTo: "#ContactLanding" });
	}

	function revealHero() {
		const hero = document.getElementById("hero");
		// dataset guard: astro:page-load also fires on the initial visit,
		// after we have already revealed — don't run twice on the same element
		if (!hero || hero.dataset.revealed) return;
		hero.dataset.revealed = "true";

		document
			.getElementById("scroll-down-button")
			?.addEventListener("click", scrollDown);
		document
			.getElementById("contact-landing-button")
			?.addEventListener("click", scrollDownContact);

		gsap.to("[data-hero-reveal]", {
			blur: 0,
			duration: 1,
			opacity: 1,
		});
	}

	// Reveal as soon as the DOM is parsed. astro:page-load waits for window
	// "load" (all images/video fetched), which on slow mobile connections
	// keeps the hero text invisible for seconds.
	revealHero();
	// Still needed for client-side navigations back to this page
	document.addEventListener("astro:page-load", revealHero);
</script>
